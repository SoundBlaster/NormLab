{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "jsx-a11y"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "eslint/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "jsx-a11y/no-noninteractive-tabindex": "error",
    "jsx-a11y/prefer-tag-over-role": "off"
  },
  "overrides": [
    {
      "files": ["tests/**/*.ts"],
      "rules": {
        "typescript/no-floating-promises": "off"
      }
    },
    {
      "files": ["client/pages/reform-lab/ui/Views.tsx"],
      "rules": {
        "jsx-a11y/no-noninteractive-tabindex": "off"
      }
    },
    {
      "files": ["client/**/ui/**", "client/app/**"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^(\\.\\./)+shared/",
                "message": "Import canonical domain contracts through a page model or entity public API, not directly from UI."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["client/**/index.ts"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^@/|^\\.\\./|/\\.\\./",
                "message": "FSD public APIs expose local modules only; import other slices at their consumer."
              }
            ]
          }
        ]
      }
    }
  ],
  "env": {
    "builtin": true
  }
}
