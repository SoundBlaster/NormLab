"""Direct literal discovery candidate; source text is never normalized."""

import json
from types import SimpleNamespace

PROMPT = """Извлеки явные утверждения только из сообщения пользователя.
Каждый statement — дословная цитата предложения или самостоятельной части
предложения. Сохрани русский язык, регистр, отрицания, даты и контекст.
Не переводи и не исправляй текст. Не добавляй отсутствующие факты и правовые выводы.
Сохрани обе стороны противоречия как отдельные утверждения.

subject обозначает автомобиль или лицо, о котором утверждение, а НЕ автора слов.
Для одного автомобиля используй vehicle_1. Различай явно разные автомобили.
aboutEpisode обозначает стоянку: episode_1 для одной стоянки; явно разные стоянки
получают разные episode_1, episode_2. Разные утверждения об одной стоянке НЕ
создают разные эпизоды. Включай указание эпизода в цитату, если оно есть.

speaker — источник утверждения, даже если его пересказывает рассказчик.
Слова самого рассказчика: narrator. Утверждение из письма: letter_1;
из уведомления или постановления: notice_1; из заметки: note_1.
Приписывай утверждение источнику, указанному непосредственно рядом с ним,
в том числе при косвенной речи. Утверждение из письма НЕ становится narrator
из-за того, что рассказчик описывает письмо. Сохрани вводные слова об источнике
в дословной цитате. Различай разные источники одного типа по номеру.
Не делай вывод о достоверности или правильности утверждений.

Ответ — только JSON по переданной схеме. Все поля обязательны.
"""


def discover(client, source, schema, calls):
    params = {
        "model": "openai/gpt-oss-20b",
        "messages": [
            {
                "role": "system",
                "content": PROMPT + "\n" + json.dumps(schema, ensure_ascii=False),
            },
            {"role": "user", "content": source},
        ],
        "temperature": 0,
        "seed": 42,
        "max_tokens": 8192,
        "response_format": {
            "type": "json_schema",
            "json_schema": {"name": "discovery", "strict": True, "schema": schema},
        },
    }
    call = {"stage": "discovery", "request": params}
    calls.append(call)
    response = client.chat.completions.create(**params)
    call["response"] = response.model_dump(mode="json")
    choice = response.choices[0]
    call["output"] = choice.message.content
    if choice.finish_reason != "stop" or choice.message.refusal:
        raise ValueError("Incomplete or refused discovery response")
    parsed = json.loads(choice.message.content)
    if not isinstance(parsed, dict) or set(parsed) != {"extractions"}:
        raise ValueError("Discovery object contract")
    items = parsed["extractions"]
    if not isinstance(items, list) or len(items) > 256:
        raise ValueError("Discovery array contract")
    extractions = []
    for item in items:
        if not isinstance(item, dict) or set(item) != {
            "statement",
            "statement_attributes",
        }:
            raise ValueError("Discovery item contract")
        attrs = item["statement_attributes"]
        if not isinstance(attrs, dict) or set(attrs) != {
            "subject",
            "aboutEpisode",
            "speaker",
        }:
            raise ValueError("Discovery attributes contract")
        extractions.append(
            SimpleNamespace(
                extraction_text=item["statement"], attributes=attrs, char_interval=None
            )
        )
    return SimpleNamespace(extractions=extractions)
