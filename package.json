{
  "name": "normlab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts --production",
    "check": "tsc --noEmit",
    "lint": "npm run lint:code && npm run lint:architecture",
    "format": "prettier --write client server shared scripts tests vite.config.ts package.json tsconfig.json .prettierrc.json .oxlintrc.json compose.yaml .github/workflows/ci.yml .github/workflows/publish-staging-image.yml .github/dependabot.yml steiger.config.ts",
    "format:check": "prettier --check client server shared scripts tests vite.config.ts package.json tsconfig.json .prettierrc.json .oxlintrc.json compose.yaml .github/workflows/ci.yml .github/workflows/publish-staging-image.yml .github/dependabot.yml steiger.config.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:lean": "tsx --test --test-concurrency=1 tests/*.integration.ts",
    "reform:demo": "tsx scripts/reform-demo.ts",
    "reform:verify": "tsx scripts/reform-verify.ts",
    "reform:explain": "tsx scripts/reform-explain.ts",
    "reform:metrics": "tsx scripts/reform-metrics.ts",
    "reform:pack": "tsx scripts/reform-pack.ts",
    "reform:import": "tsx scripts/reform-import.ts",
    "schemas:write": "tsx scripts/export-contracts.ts",
    "schemas:check": "tsx scripts/export-contracts.ts --check",
    "parking:replay:bound": "tsx scripts/parking-bound-replay.ts",
    "parking:runtime:build": "tsx scripts/parking-lean-runtime.ts",
    "parking:references:check": "tsx scripts/check-parking-references.ts",
    "parking:baseline": "tsx scripts/parking-baseline.ts",
    "parking:evaluate": "tsx scripts/parking-evaluate.ts",
    "parking:evaluate:synthetic": "tsx scripts/parking-synthetic-evaluate.ts",
    "lint:code": "oxlint --type-aware --deny-warnings --report-unused-disable-directives-severity error client server shared scripts tests vite.config.ts steiger.config.ts",
    "lint:architecture": "tsx scripts/lint-architecture.ts client --fail-on-warnings",
    "test:architecture": "tsx --test tests/steiger-braces-guard.test.ts tests/fsd-boundaries.test.ts",
    "parking:motivation": "tsx scripts/parking-motivation.ts",
    "parking:motivation:check": "tsx scripts/parking-motivation.ts check"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "undici": "8.12.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@feature-sliced/steiger-plugin": "0.8.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2004",
    "prettier": "3.9.10",
    "steiger": "0.8.0",
    "tsx": "^4.20.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "packageManager": "npm@10.9.3"
}
