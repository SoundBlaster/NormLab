{
  "name": "normlab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts --production",
    "check": "tsc --noEmit",
    "lint": "oxlint --type-aware --deny-warnings --report-unused-disable-directives-severity error client server shared scripts tests vite.config.ts",
    "format": "prettier --write client server shared scripts tests vite.config.ts package.json tsconfig.json .prettierrc.json .oxlintrc.json compose.yaml .github/workflows/ci.yml .github/dependabot.yml",
    "format:check": "prettier --check client server shared scripts tests vite.config.ts package.json tsconfig.json .prettierrc.json .oxlintrc.json compose.yaml .github/workflows/ci.yml .github/dependabot.yml",
    "test": "tsx --test tests/*.test.ts",
    "test:lean": "tsx --test --test-concurrency=1 tests/*.integration.ts",
    "reform:demo": "tsx scripts/reform-demo.ts",
    "reform:verify": "tsx scripts/reform-verify.ts",
    "reform:explain": "tsx scripts/reform-explain.ts",
    "reform:metrics": "tsx scripts/reform-metrics.ts",
    "reform:pack": "tsx scripts/reform-pack.ts",
    "reform:import": "tsx scripts/reform-import.ts",
    "schemas:write": "tsx scripts/export-contracts.ts",
    "schemas:check": "tsx scripts/export-contracts.ts --check",
    "parking:references:check": "tsx scripts/check-parking-references.ts",
    "parking:baseline": "tsx scripts/parking-baseline.ts",
    "parking:evaluate": "tsx scripts/parking-evaluate.ts",
    "parking:evaluate:synthetic": "tsx scripts/parking-synthetic-evaluate.ts"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "prettier": "3.9.9",
    "tsx": "^4.20.0",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  }
}
