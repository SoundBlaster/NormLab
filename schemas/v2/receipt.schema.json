{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "payload": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string",
          "const": "normlab.receipt/v2"
        },
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
        },
        "queryKind": {
          "type": "string",
          "enum": [
            "decision",
            "comparison",
            "property"
          ]
        },
        "bindings": {
          "type": "object",
          "properties": {
            "queryDigest": {
              "$ref": "#/$defs/__schema0"
            },
            "certificateDigest": {
              "$ref": "#/$defs/__schema0"
            },
            "resultDigest": {
              "$ref": "#/$defs/__schema0"
            },
            "statementDigest": {
              "$ref": "#/$defs/__schema0"
            },
            "assumptionsDigest": {
              "$ref": "#/$defs/__schema0"
            },
            "models": {
              "minItems": 1,
              "maxItems": 2,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema1"
              }
            }
          },
          "required": [
            "queryDigest",
            "certificateDigest",
            "resultDigest",
            "statementDigest",
            "assumptionsDigest",
            "models"
          ],
          "additionalProperties": false
        },
        "coverage": {
          "type": "object",
          "properties": {
            "domainDigest": {
              "$ref": "#/$defs/__schema0"
            },
            "kind": {
              "type": "string",
              "enum": [
                "snapshot-completions",
                "finite-domain",
                "corpus"
              ]
            },
            "status": {
              "type": "string",
              "enum": [
                "declared-complete",
                "partial"
              ]
            },
            "declaredCardinality": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16
            },
            "coveredCardinality": {
              "type": "integer",
              "minimum": 0,
              "maximum": 16
            }
          },
          "required": [
            "domainDigest",
            "kind",
            "status",
            "declaredCardinality",
            "coveredCardinality"
          ],
          "additionalProperties": false
        },
        "verification": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "verified",
                "inconclusive",
                "rejected",
                "unsupported"
              ]
            },
            "engine": {
              "type": "string",
              "const": "lean-kernel"
            },
            "version": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[\\s\\S]{1,200}(?![\\s\\S])",
                  "minLength": 1,
                  "maxLength": 200
                },
                {
                  "type": "null"
                }
              ]
            },
            "method": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "case-theorem",
                    "finite-domain-theorem"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "toolchainDigest": {
              "anyOf": [
                {
                  "$ref": "#/$defs/__schema0"
                },
                {
                  "type": "null"
                }
              ]
            },
            "axioms": {
              "maxItems": 16,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema2"
              }
            },
            "reason": {
              "type": "string",
              "pattern": "^[\\s\\S]{1,2000}(?![\\s\\S])",
              "minLength": 1,
              "maxLength": 2000
            }
          },
          "required": [
            "status",
            "engine",
            "version",
            "method",
            "toolchainDigest",
            "axioms",
            "reason"
          ],
          "additionalProperties": false
        },
        "issuer": {
          "$ref": "#/$defs/__schema0"
        }
      },
      "required": [
        "schema",
        "id",
        "createdAt",
        "queryKind",
        "bindings",
        "coverage",
        "verification",
        "issuer"
      ],
      "additionalProperties": false
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]{86}==$"
    },
    "publicKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    }
  },
  "required": [
    "payload",
    "signature",
    "publicKey"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "__schema1": {
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "enum": [
            "model",
            "baseline",
            "candidate"
          ]
        },
        "bundle": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 96,
              "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
            },
            "semanticDigest": {
              "$ref": "#/$defs/__schema0"
            },
            "provenanceDigest": {
              "$ref": "#/$defs/__schema0"
            },
            "profileDigest": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "required": [
            "id",
            "semanticDigest",
            "provenanceDigest",
            "profileDigest"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "role",
        "bundle"
      ],
      "additionalProperties": false
    },
    "__schema2": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96
    }
  },
  "$id": "urn:normlab:contract:v2:receipt"
}
