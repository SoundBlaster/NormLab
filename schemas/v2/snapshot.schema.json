{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "narrative": {
      "type": "string",
      "pattern": "^[\\s\\S]{1,6000}(?![\\s\\S])",
      "minLength": 1,
      "maxLength": 6000
    },
    "group": {
      "type": "string",
      "enum": [
        "K1",
        "K2"
      ]
    },
    "findings": {
      "type": "object",
      "properties": {
        "M": {
          "$ref": "#/$defs/__schema0"
        },
        "N": {
          "$ref": "#/$defs/__schema0"
        },
        "E": {
          "$ref": "#/$defs/__schema0"
        }
      },
      "required": [
        "M",
        "N",
        "E"
      ],
      "additionalProperties": false
    },
    "schema": {
      "type": "string",
      "const": "normlab.snapshot/v2"
    },
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "caseId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$"
    },
    "supersedes": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        {
          "type": "null"
        }
      ]
    },
    "authority": {
      "type": "string",
      "const": "simulated-reviewer"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "narrative",
    "group",
    "findings",
    "schema",
    "id",
    "caseId",
    "revision",
    "createdAt",
    "supersedes",
    "authority",
    "digest"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "unreviewed",
            "established",
            "refuted",
            "not-established"
          ]
        },
        "rationale": {
          "type": "string",
          "pattern": "^[\\s\\S]{0,2000}(?![\\s\\S])",
          "minLength": 0,
          "maxLength": 2000
        }
      },
      "required": [
        "state",
        "rationale"
      ],
      "additionalProperties": false
    }
  },
  "$id": "urn:normlab:contract:v2:snapshot"
}
